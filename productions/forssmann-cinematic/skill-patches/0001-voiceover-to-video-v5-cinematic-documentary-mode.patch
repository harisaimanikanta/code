+def _eye_material(iris='#4a5a6a'):
+    """Eyeball: sclera (warm white, faint veins), coloured iris with radial fibres, black pupil, wet cornea (clear coat)."""
+    m = bpy.data.materials.new('eye'); m.use_nodes = True; n = ck.N(m); b = n.bsdf()
