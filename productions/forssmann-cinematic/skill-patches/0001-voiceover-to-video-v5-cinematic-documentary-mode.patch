+    sk2 = n.new('ShaderNodeMath', operation='MULTIPLY'); n.link(socks, 0, sk2, 0); sk2.inputs[1].default_value = 0.22 + 0.15 * min(1, max(0, (age - 30) / 30))
+    col2 = ck._mix(n, col.outputs[2], '#6a4038', sk2.outputs[0])
