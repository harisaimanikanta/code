+    sq = n.new('ShaderNodeVectorMath', operation='LENGTH'); cb = n.new('ShaderNodeCombineXYZ'); n.link(sep, 'X', cb, 'X'); n.link(sep, 'Z', cb, 'Z'); n.link(cb, 0, sq, 0)
