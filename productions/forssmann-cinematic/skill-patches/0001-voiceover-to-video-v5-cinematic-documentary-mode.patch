+    rr = n.new('ShaderNodeMapRange', To_Min=0.45, To_Max=0.28); n.link(lipc, 0, rr, 'Value'); n.link(rr, 0, b, 'Roughness')
+    pores = n.new('ShaderNodeTexVoronoi', Scale=900.0); n.link(tc, 'Object', pores, 'Vector')
